{
  "name": "voice-lounge-bot",
  "version": "1.0.0",
  "description": "Discord bot that spins up on-demand public and private voice channels from a lounge hub",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "register": "npm run build && node dist/register.js",
    "deploy": "npm-run-all build register start",
    "postinstall": "npm run build"
  },
  "keywords": ["discord", "bot", "voice", "temporary-channels", "typescript"],
  "author": "PineFruitDev <contact@pinefruit.dev>",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@types/node": "^24.5.2",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
